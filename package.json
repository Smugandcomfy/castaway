    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@dfinity/candid": "^3.4.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "esbuild-sass-plugin": "^3.7.0",
    "icblast": "^4.3.0",
    "neutron-scripts": "^1.1.0"
  }
